# svs-to-ometiff GUI Environment Configuration
# Copy this file to .env and customize as needed.

# Server
SVS_GUI_HOST=127.0.0.1
SVS_GUI_PORT=8765

# Conversion defaults
SVS_GUI_TILE_SIZE=512
SVS_GUI_COMPRESSION=lzw
SVS_GUI_NUM_LEVELS=6
SVS_GUI_DOWNSAMPLE=2
SVS_GUI_EDGE_MODE=crop

# Limits
SVS_GUI_MAX_JOBS=1
